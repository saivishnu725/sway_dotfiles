# Dracula-inspired notification colors.
background-color=#282a36
text-color=#f8f8f2
border-color=#bd93f9
border-size=2

# Show notifications near the top-right corner of the screen.
anchor=top-right
# Dismiss ordinary notifications after 5 seconds (milliseconds).
default-timeout=5000
# Leave a small margin around notifications, in pixels.
margin=10
# Limit notification width, in pixels.
width=350

# Group audio key notifications and dismiss them quickly.
[app-name="Sway audio"]
group-by=app-name
default-timeout=1500

# Hide notifications while Do Not Disturb is enabled.
[mode=do-not-disturb]
invisible=1
