# Lines beginning with # explain the configuration.
# Mod4 is the Super/Windows key; Mod1 would be Alt.
set $mod Mod4

# Tap the touchpad surface to click without pressing its physical button.
input type:touchpad {
    tap enabled
}

# bindsym maps a key combination to a command; exec starts a program.
# KDE terminal
bindsym $mod+t exec cosmic-term
# Application launcher
bindsym $mod+d exec wofi --insensitive --show drun
# KDE file manager
bindsym $mod+e exec env QT_QPA_PLATFORMTHEME=kde dolphin
# Browser
bindsym $mod+b exec firefox
# Network connection editor
bindsym $mod+n exec nm-connection-editor
# Audio controls
bindsym $mod+a exec pavucontrol

# Open the external-display mode menu.
bindsym $mod+p exec python3 ~/.config/sway/displays.py

# Search the shortcuts listed in this Sway config.
bindsym $mod+Shift+slash exec python3 ~/.config/sway/shortcuts.py

# Select a region and open it in Swappy for annotation (requires swappy).
bindsym $mod+s exec sh ~/.config/sway/screenshot.sh

# Open KDE Kalk with the keyboard calculator key.
bindsym XF86Calculator exec env QT_QPA_PLATFORMTHEME=kde kalk

# Hardware audio keys control the default output through WirePlumber.
# Each press changes volume by 5%; the increase is capped at 100%.
bindsym --locked XF86AudioRaiseVolume exec python3 ~/.config/sway/audio.py up
bindsym --locked XF86AudioLowerVolume exec python3 ~/.config/sway/audio.py down
# Toggle output mute or microphone mute; --locked also allows these while locked.
bindsym --locked XF86AudioMute exec python3 ~/.config/sway/audio.py mute
bindsym --locked XF86AudioMicMute exec python3 ~/.config/sway/audio.py mic

# Rotate images from ~/Pictures/Wallpaper every fifteen minutes (requires swaybg).
exec python3 ~/.config/sway/wallpaper.py

# Record copied text and images in cliphist (requires the cliphist package).
exec wl-paste --type text --watch cliphist store
exec wl-paste --type image --watch cliphist store
# Search history and copy the selected item back to the clipboard.
bindsym $mod+Shift+v exec sh -c 'cliphist list | wofi --dmenu --insensitive --prompt "Clipboard history" | cliphist decode | wl-copy'

# Start the notification daemon once when the Sway session starts.
exec mako

# Lock the session manually (requires the swaylock package).
bindsym $mod+Escape exec swaylock

# Close a window, reload this file, or confirm before exiting Sway.
bindsym $mod+q kill
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exec swaynag -t warning -m 'Exit Sway and end this session?' -B 'Yes, exit Sway' 'swaymsg exit'
# Toggle fullscreen.
bindsym $mod+f fullscreen toggle
# Toggle floating mode.
bindsym $mod+Shift+space floating toggle
# Alternative floating shortcut.
bindsym $mod+Shift+f floating toggle
# Hold Super and drag with left mouse to move or right mouse to resize.
floating_modifier $mod normal

# Arrow keys change focus; adding Shift moves the focused window.
bindsym $mod+Left focus left
bindsym $mod+Right focus right
bindsym $mod+Up focus up
bindsym $mod+Down focus down
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Right move right
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Down move down

# Set the split direction for new windows: horizontal or vertical.
bindsym $mod+h splith
bindsym $mod+v splitv
# Choose tabbed, stacked, or split display for the focused container.
bindsym $mod+w layout tabbed
bindsym $mod+Ctrl+s layout stacking
bindsym $mod+Shift+s layout toggle split

# Select workspaces 1–10; add Shift to move the focused window there.
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

# Open KDE Kalk as a floating window when its Wayland app ID matches.
for_window [app_id="org.kde.kalk"] floating enable

# Open Calindori as a compact floating window when its Wayland app ID matches.
for_window [app_id="org.kde.calindori"] floating enable, resize set 500 600

# Muted rose accent for the focused window border, title bar, and indicator.
# Fields: border, background, text, indicator, child border.
client.focused #B76E79 #B76E79 #ffffff #B76E79 #B76E79

# Show workspace buttons and a clickable clock in a bar at the top.
bar {
    position top
    # Focused workspace colors: border, background, text.
    colors {
        focused_workspace #B76E79 #B76E79 #ffffff
    }
    # Run the repository clock script through the config symlink.
    status_command python3 ~/.config/sway/clock.py
}

# Load distribution session integration, including portal environment setup.
include /etc/sway/config.d/*
