# Set personal aliases, overriding those provided by Oh My Zsh libs,
# plugins, and themes. Aliases can be placed here, though Oh My Zsh
# users are encouraged to define aliases within a top-level file in
# the $ZSH_CUSTOM folder, with .zsh extension. Examples:
# - $ZSH_CUSTOM/aliases.zsh
# - $ZSH_CUSTOM/macos.zsh
# For a full list of active aliases, run `alias`.
#
# Example aliases
# alias zshconfig="mate ~/.zshrc"
# alias ohmyzsh="mate ~/.oh-my-zsh"
fastfetch
# git aliases
alias gits="git status"
alias gita="git add "
alias gitaa="git add ."
alias gitas="git add . && git status"
alias gitac="git add . && git commit -s -m"
alias gitc="git commit -s -m"
alias gitl="git log"
alias gitlo="git log --oneline"
alias gitp="git push"
gitacp() {
	git add .
	git commit -s -m $1
	git push 
}

# rust aliases
alias cb="cargo build"
alias cn="cargo new"
alias cr="cargo run"
alias cclean="cargo clean"
. "$HOME/.cargo/env"

# zsh edit
alias zshedit="nvim ~/.zshrc && source ~/.zshrc"

# system
alias vim="nvim"

# c
EDITOR=nvim

onlyname () {
    filename=$1
    name=${filename%.*}
    echo $name
}

c () {
    mkdir -p exec_files/
    filename=$1
    name=$(onlyname $filename)
    $EDITOR $filename
    gcc -Wall -Wextra -Werror -std=c17 $filename -o ./exec_files/$name
    ./exec_files/$name
}
